{
  "name": "jidian-campus",
  "version": "1.0.0",
  "private": true,
  "description": "机电校园 - 校园社交平台（可独立部署到 Vercel）",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "NODE_ENV=development nest start --watch",
    "dev:client": "NODE_ENV=development vite",
    "build": "npm run build:server && npm run build:client",
    "build:vercel": "npm run build",
    "build:server": "NODE_ENV=production nest build",
    "build:client": "NODE_ENV=production vite build",
    "start": "NODE_ENV=production node dist/server/bootstrap.js"
  },
